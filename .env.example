# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (sb_secret_...) or legacy service_role key. Server-only — never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Admin sign-in password (the only login in the app)
ADMIN_PASSWORD=
# Random string, 32+ chars, signs the admin cookie. e.g. `openssl rand -base64 32`
SESSION_SECRET=

# Optional: "Continue with Google" for the admin (Google Cloud → Credentials → OAuth client ID, type Web).
# Authorized redirect URI: https://<your-domain>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only this Google account becomes admin
ADMIN_EMAIL=
